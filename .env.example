APP_NAME=DroneVerse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE=
LEMON_SQUEEZY_SIGNING_SECRET=

# Lemon Squeezy variant IDs, one per billing period sold. A test store and a
# live store carry different IDs for the same product, so these are set per
# environment and never committed. The _LAUNCH variants must stay hidden in the
# store: only ResolveCheckoutPrice may select them.
LEMON_SQUEEZY_VARIANT_PRO_MONTHLY=
LEMON_SQUEEZY_VARIANT_PRO_YEARLY=
LEMON_SQUEEZY_VARIANT_PRO_MONTHLY_LAUNCH=
LEMON_SQUEEZY_VARIANT_PRO_YEARLY_LAUNCH=
LEMON_SQUEEZY_VARIANT_TEAM_MONTHLY=
LEMON_SQUEEZY_VARIANT_TEAM_YEARLY=
LEMON_SQUEEZY_VARIANT_TEAM_SEAT_MONTHLY=
LEMON_SQUEEZY_VARIANT_TEAM_SEAT_YEARLY=

# The product each set of variants above belongs to. Only changing the plan of
# an existing subscription needs these — Lemon Squeezy's update endpoint takes a
# product and a variant together — so an environment without them can still sell
# every tier, and can still move a subscriber between billing periods.
LEMON_SQUEEZY_PRODUCT_PRO=
LEMON_SQUEEZY_PRODUCT_TEAM=

# Where the pricing page's Enterprise button writes to. Unset, it renders
# disabled rather than opening an empty mail client.
SALES_EMAIL=

VITE_APP_NAME="${APP_NAME}"
