APP_NAME=DroneVerse
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The log viewer serves log contents, whole-file downloads and file deletion at
# /log-viewer. Off unless an environment deliberately turns it on: the package
# only guards those routes when APP_ENV is exactly "production", so a staging or
# preview box served them to anyone who found the URL.
LOG_VIEWER_ENABLED=false

# Who may read the logs when it is enabled, comma separated. Empty denies
# everyone — see the `viewLogViewer` gate in AppServiceProvider.
LOG_VIEWER_ALLOWED_EMAILS=

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# The disk a pilot's simulator photos live on. Leave as `photos` locally; set
# to `s3` anywhere the filesystem does not survive a release, or the photo log
# empties itself on every deploy. `s3` needs the AWS_* block below filled in.
PHOTO_DISK=photos

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# S3-compatible stores (Cloudflare R2, MinIO) need their endpoint named here.
# Leave blank for real S3. R2 also wants AWS_DEFAULT_REGION=auto.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Kelviq billing. Paste the block from Settings > Setup with AI in the Kelviq
# dashboard ("Copy for your .env file"). KELVIQ_ENV picks the world the keys
# belong to: unset or `sandbox` is test mode, and `production` is set only in
# the hosting settings when going live — never in a committed file. The
# webhook secret is written by `npx kelviq webhook add ... --write-secret .env`.
# Only the server key is read by the application; the client key is unused.
KELVIQ_SERVER_API_KEY=
KELVIQ_CLIENT_API_KEY=
KELVIQ_ENV=sandbox
KELVIQ_WEBHOOK_SECRET=
# Where institutions asking about academic pricing are sent, and the address
# /terms and /privacy fall back to when neither address below is set. Nothing on
# the pricing page reads it: every tier there is bought with a card.
SALES_EMAIL=

# Who /terms and /privacy say you are. Both pages leave a visible gap wherever
# one of these is unset rather than inventing a company, so a production
# deployment selling into the EU should have all of them filled in: the trader
# has to be identifiable before a sale, and the controller before a signup.
LEGAL_ENTITY_NAME=
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_COUNTRY=
LEGAL_ENTITY_REGISTRATION=

# Withdrawal notices and data subject requests. Either address falls back to
# the other, and both fall back to SALES_EMAIL, so the pages never promise a
# right with nowhere to exercise it.
LEGAL_SUPPORT_EMAIL=
LEGAL_PRIVACY_EMAIL=

# GDPR Article 27. A controller outside the EU that sells to people in the EU
# must appoint a representative there and publish who they are. The privacy
# page renders this section only when a name is set — an empty heading
# advertises a breach, and a name we have not appointed is a false one.
LEGAL_EU_REPRESENTATIVE_NAME=
LEGAL_EU_REPRESENTATIVE_ADDRESS=
LEGAL_EU_REPRESENTATIVE_EMAIL=

# Where the data actually sits, in plain words ("the United States"). Article
# 13(1)(f) makes leaving the EEA a disclosure of its own, so this follows the
# hosting region and the object store and changes when they do.
LEGAL_HOSTING_REGION=

VITE_APP_NAME="${APP_NAME}"
