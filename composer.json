{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "inertiajs/inertia-laravel": "^3.4.0",
        "laravel/chisel": "^0.1.1",
        "laravel/fortify": "^1.40.0",
        "laravel/framework": "^13.33.0",
        "laravel/tinker": "^3.0.2",
        "laravel/wayfinder": "^0.1.21",
        "league/flysystem-aws-s3-v3": "^3.35.3",
        "opcodesio/log-viewer": "^3.24.2",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24.1",
        "heyosseus/sloppy": "^1.1.1",
        "larastan/larastan": "^3.12.2",
        "laravel/boost": "^2.10.0",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.68",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.2.1",
        "pestphp/pest-plugin-phpstan": "^5.2.1",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "rector/rector": "^2.6.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "update:requirements": [
            "composer bump",
            "npx npm-check-updates u"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "npm run lint"
        ],
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "npm run lint:check"
        ],
        "test:unit": "XDEBUG_MODE=\"coverage\" pest --parallel --tia --coverage --exactly=100.0 --no-progress",
        "test:types": [
            "phpstan",
            "npm run types:check"
        ],
        "lint:check": [
            "pint --parallel --test"
        ],
        "rector": [
            "rector process"
        ],
        "rector:check": [
            "rector process --dry-run"
        ],
        "ci:check": [
            "Composer\\Config::disableProcessTimeout",
            "@audit:check",
            "@rector:check",
            "npm run lint:check",
            "npm run format:check",
            "npm run types:check",
            "npm run test",
            "@test"
        ],
        "types:check": [
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "audit:check": [
            "@composer audit",
            "npm audit --audit-level=high"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@lint:check",
            "@types:check",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": []
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
