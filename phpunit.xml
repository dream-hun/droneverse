<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <!--
            The suite must pass with no Lemon Squeezy credentials, and it must
            pass the same way on a machine whose .env has real ones. Blanked
            here so the tests that assert an unconfigured environment — the
            pricing page rendering with checkout disabled, a webhook refused
            because no signing secret is set — cannot be quietly disarmed by a
            developer's local store. Tests that need a credential set it with
            config() for the duration of the test.
        -->
        <env name="LEMON_SQUEEZY_API_KEY" value=""/>
        <env name="LEMON_SQUEEZY_STORE" value=""/>
        <env name="LEMON_SQUEEZY_SIGNING_SECRET" value=""/>
        <!--
            The log viewer ships disabled in .env.example, which unregisters its
            routes entirely. That is right for a real environment and wrong for
            this one: LogViewerAccessTest exists to prove the `viewLogViewer`
            gate turns those routes away, and it cannot prove anything about
            routes that were never registered — with the flag off it errors with
            "Route [log-viewer.index] not defined", which reads like a broken
            test rather than an unguarded endpoint. Forced on here so the
            middleware is always exercised, whatever a given .env says.
        -->
        <env name="LOG_VIEWER_ENABLED" value="true"/>
        <!--
            Blanked for the same reason as the credentials above: the tests
            assert that an empty allowlist denies everyone, and a developer whose
            .env names themselves would otherwise disarm that quietly. Tests that
            need somebody allowed set it with config() for their duration.
        -->
        <env name="LOG_VIEWER_ALLOWED_EMAILS" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
